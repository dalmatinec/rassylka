# Скопируй в .env и заполни:  cp .env.example .env && nano .env

# Токен бота от @BotFather
BOT_TOKEN=

# ID админов через запятую (плюс к ним работают админы из таблицы admins в базе)
ADMIN_IDS=

# ID админской группы (где работают /new, /list, /groups)
ADMIN_GROUP_ID=

# Туннель (сервис nl-tunnel). Пусто — без туннеля
PROXY_URL=socks5://127.0.0.1:1080
